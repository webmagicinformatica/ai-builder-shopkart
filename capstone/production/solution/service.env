# The production settings, in one place. deploy.sh turns them into the ECS service's
# environment. No secrets here: the API key comes from Secrets Manager, by reference.

# The model: the small one. The prompt version goes on every model span and the dashboard.
LLM_PROVIDER=anthropic
MODEL=claude-haiku-5-5
PROMPT_VERSION=doc-v1

# Size: 1 vCPU and 2 GB per task. With the two local models loaded the app uses ~600 MB:
# 0.5 GB answered one question, then was OOM-killed. The reranker is CPU work: a question took
# ~5.5 s on 0.25 vCPU, ~3 s on 0.5, ~2 s on 1 (each with a 1 s pretend model wait). See WHAT-BROKE.md.
CPU=1024
MEMORY=2048
# Scale on CPU, not requests: search, not the model, is the busy part here. At most 2 tasks.
MIN_TASKS=1
MAX_TASKS=2
SCALE_METRIC=AVERAGE_CPU
SCALE_TARGET=60
RERANK_CANDIDATES=10

# Per-user limits: 10 questions a minute, ₹5 a day (about 400 questions on Haiku).
USER_PER_MINUTE=10
USER_DAILY_INR=5
# The daily cap: ₹88 (about $1) a day IN TOTAL. The counters live in each task's memory, so
# each task enforces its share: ₹88 / MAX_TASKS = ₹44. Ladder: alert 80%, degrade 90%, lite 100%.
GLOBAL_DAILY_INR=44
# The hard stop per task (shopkart.budget), just above the ladder's 100% (₹44 = $0.50).
DAILY_BUDGET_USD=0.55
